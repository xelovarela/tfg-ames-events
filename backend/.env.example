# Backend configuration example.
# Copy this file to backend/.env and replace placeholder values as needed.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=ames_events
DB_PORT=3306

JWT_SECRET=change-this-in-production
APP_BASE_URL=http://localhost:3000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM="Ames Events <no-reply@ames-events.local>"

PORT=3001

CORS_ORIGINS=http://localhost:3000,https://ames-events.anxovarela.es

# Absolute filesystem path where uploaded event images are stored by the backend.
# In hosting, this directory must exist and be writable by the Node process.
# EVENT_IMAGES_DIR=/home/your-user/api/uploads/events
# Public base URL used when saving uploaded image URLs in the database.
# EVENT_IMAGES_PUBLIC_BASE_URL=https://api.anxovarela.es
# Absolute filesystem path where uploaded category images are stored by the backend.
# CATEGORY_IMAGES_DIR=/home/your-user/api/uploads/categories
# Public base URL used when saving uploaded category image URLs in the database.
# CATEGORY_IMAGES_PUBLIC_BASE_URL=https://api.anxovarela.es
